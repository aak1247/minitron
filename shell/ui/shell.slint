// Only the preparation path creates a window; a ready runtime launches directly.
import { Button, ProgressIndicator, TextEdit } from "std-widgets.slint";
export { I18n } from "translations.slint";
import { I18n } from "translations.slint";

component Step inherits Rectangle {
    in property <string> number;
    in property <string> label;
    in property <bool> active;
    in property <bool> complete;
    in property <bool> failed;
    private property <bool> attention: active && failed;
    height: 28px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 24px; height: 24px; border-radius: 12px;
            background: root.attention ? #fff0e4 : root.active ? #e5edff : root.complete ? #e5f2ed : #eef0f5;
            Text {
                visible: !root.complete;
                text: root.attention ? "!" : root.number;
                color: root.attention ? #a75426 : root.active ? #315dcc : root.complete ? #26765b : #61708c;
                font-size: 11px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Image {
                visible: root.complete;
                x: 6px; y: 6px; width: 12px; height: 12px;
                source: @image-url("../assets/check.svg");
                accessible-role: none;
            }
        }
        Text {
            text: root.label;
            color: root.attention ? #a75426 : root.active ? #20375e : root.complete ? #475c58 : #61708c;
            font-size: 12px; font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

export component ShellWindow inherits Window {
    title: "minitron · " + I18n.labels.launcher;
    icon: @image-url("../assets/icon.png");
    preferred-width: 660px; preferred-height: 500px;
    min-width: 620px; min-height: 500px;
    background: #f4f6fc;
    default-font-family: I18n.language == "zh" ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 13px;

    in property <string> stage: "checking";
    // Technical error details, separate from localized status and guidance.
    in property <string> message: "";
    in property <string> runtime-label: "Electron";
    in property <string> transfer-label: "";
    in property <float> progress: 0.0;
    in property <bool> indeterminate: true;
    private property <bool> details-expanded: false;
    private property <bool> failed: stage == "error";
    private property <bool> verifying: stage == "verifying";
    private property <bool> done: stage == "done";
    private property <bool> download-complete: verifying || done || (failed && progress >= 1);
    callback retry();

    // Painted Mica-inspired material, compatible with the software renderer.
    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: @linear-gradient(115deg, #edf3ff 0%, #f5f4ff 60%, #eaeafb 100%);
    }
    VerticalLayout {
        padding: 32px; padding-top: 24px; padding-bottom: 20px;
        spacing: 16px;
        HorizontalLayout {
            height: 30px; spacing: 10px;
            Rectangle {
                width: 30px; height: 30px; border-radius: 9px;
                background: #5769e8;
                Text { text: "m"; color: white; font-size: 23px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "minitron"; color: #263654; font-size: 18px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 85px; height: 26px; border-radius: 13px;
                background: #ffffff90; border-width: 1px; border-color: #ffffff;
                Text { text: I18n.labels.launcher; color: #61708c; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Rectangle {
            height: 148px;
            Image {
                source: @image-url("../assets/runtime-layers.svg");
                width: 200px; height: 170px;
                x: parent.width - self.width + 8px; y: -6px;
                accessible-role: none;
            }
            VerticalLayout {
                x: 0;
                width: parent.width - 190px;
                alignment: center;
                spacing: 10px;
                Text {
                    text: root.failed ? I18n.labels.heading-failed : root.done ? I18n.labels.heading-done : I18n.labels.heading-prepare;
                    color: #202c46; font-size: 28px; font-weight: 700;
                }
                Text {
                    text: root.failed ? I18n.labels.subtitle-failed : root.done ? I18n.labels.subtitle-done : I18n.labels.subtitle-prepare;
                    color: #5e6d87; font-size: 13px; wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 152px; border-radius: 14px;
            background: #ffffff; border-width: 1px; border-color: #e2e7f2;
            drop-shadow-offset-y: 6px;
            drop-shadow-blur: 20px;
            drop-shadow-color: #4352830c;
            VerticalLayout {
                padding: 20px; spacing: 14px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 8px; height: 8px; y: 5px; border-radius: 4px;
                        background: root.failed ? #c56c32 : root.done ? #26765b : #5279df;
                    }
                    Text {
                        text: root.failed ? I18n.labels.status-failed : root.verifying ? I18n.labels.status-verifying : root.done ? I18n.labels.status-done : root.stage == "checking" ? I18n.labels.status-checking : I18n.labels.status-downloading;
                        color: #28354e; font-size: 14px; font-weight: 600;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.failed ? I18n.labels.badge-retry : root.verifying ? I18n.labels.badge-verifying : root.indeterminate ? I18n.labels.badge-wait : round(clamp(root.progress, 0, 1) * 100) + "%";
                        color: root.failed ? #a75426 : #4669be;
                        font-size: 12px; font-weight: 600;
                    }
                }
                Text {
                    text: root.failed ? I18n.labels.hint-failed : root.done ? I18n.labels.hint-done : root.verifying ? I18n.labels.hint-verifying : root.stage == "checking" ? I18n.labels.hint-checking : I18n.labels.hint-downloading;
                    color: #6c778b; font-size: 12px; overflow: elide;
                }
                ProgressIndicator {
                    visible: !root.failed; height: 5px;
                    progress: clamp(root.progress, 0, 1); indeterminate: root.indeterminate;
                    accessible-label: root.verifying ? I18n.labels.accessible-verifying : I18n.labels.accessible-progress;
                }
                if root.failed: HorizontalLayout {
                    spacing: 10px;
                    Button { text: I18n.labels.retry; primary: true; clicked => { root.details-expanded = false; root.retry(); } }
                    Button { text: root.details-expanded ? I18n.labels.hide-details : I18n.labels.error-details; clicked => { root.details-expanded = !root.details-expanded; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if !root.failed: HorizontalLayout {
                    Text { text: root.runtime-label; color: #61708c; font-size: 11px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.transfer-label; color: #61708c; font-size: 11px; }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1; min-height: 76px;
            if root.failed && root.details-expanded: TextEdit {
                x: 0; y: 0; width: parent.width; height: parent.height;
                text: root.message;
                read-only: true;
                wrap: word-wrap;
                font-size: 11px;
                accessible-label: I18n.labels.accessible-details;
            }
            if !root.failed || !root.details-expanded: VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Step { number: "1"; label: I18n.labels.step-download; active: !root.download-complete; complete: root.download-complete; failed: root.failed; }
                    Rectangle { height: 28px; Rectangle { x: 0; y: 12px; width: parent.width; height: 1px; background: #dde3ef; } }
                    Step { number: "2"; label: I18n.labels.step-verify; active: root.verifying || (root.failed && root.download-complete); complete: root.done; failed: root.failed; }
                    Rectangle { height: 28px; Rectangle { x: 0; y: 12px; width: parent.width; height: 1px; background: #dde3ef; } }
                    Step { number: "3"; label: I18n.labels.step-launch; active: root.done; }
                }
                if root.failed: Text {
                    text: I18n.labels.resume-hint;
                    color: #61708c; font-size: 11px; horizontal-alignment: center;
                }
            }
        }
    }
}
