// Keep both catalogs together so every user-facing label has a translation.
export struct Labels {
    launcher: string,
    heading-failed: string,
    heading-done: string,
    heading-prepare: string,
    subtitle-failed: string,
    subtitle-done: string,
    subtitle-prepare: string,
    status-failed: string,
    status-verifying: string,
    status-done: string,
    status-checking: string,
    status-downloading: string,
    badge-retry: string,
    badge-verifying: string,
    badge-wait: string,
    hint-failed: string,
    hint-done: string,
    hint-verifying: string,
    hint-checking: string,
    hint-downloading: string,
    accessible-verifying: string,
    accessible-progress: string,
    retry: string,
    hide-details: string,
    error-details: string,
    accessible-details: string,
    step-download: string,
    step-verify: string,
    step-launch: string,
    resume-hint: string,
}

export global I18n {
    in-out property <string> language: "en";
    out property <Labels> labels: language == "zh" ? {
        launcher: "应用启动器",
        heading-failed: "启动未完成",
        heading-done: "正在启动",
        heading-prepare: "准备启动",
        subtitle-failed: "请重试或查看错误详情。",
        subtitle-done: "即将打开应用。",
        subtitle-prepare: "准备完成后自动打开应用。",
        status-failed: "暂时无法完成准备",
        status-verifying: "正在校验并安装",
        status-done: "运行环境已就绪",
        status-checking: "正在准备运行环境",
        status-downloading: "正在下载运行环境",
        badge-retry: "需要重试",
        badge-verifying: "校验中",
        badge-wait: "请稍候",
        hint-failed: "可以重试；若问题持续，请展开错误详情查看原因。",
        hint-done: "正在打开应用，马上就好。",
        hint-verifying: "下载完成，正在检查文件完整性并安装运行环境…",
        hint-checking: "正在连接并检查运行环境…",
        hint-downloading: "正在下载所需运行环境，请保持网络连接。",
        accessible-verifying: "正在校验并安装运行环境",
        accessible-progress: "运行环境下载进度",
        retry: "重试",
        hide-details: "收起详情",
        error-details: "错误详情",
        accessible-details: "错误详情，可选择并复制",
        step-download: "获取环境",
        step-verify: "校验安装",
        step-launch: "启动应用",
        resume-hint: "重试时将尝试继续下载。",
    } : {
        launcher: "App launcher",
        heading-failed: "Startup interrupted",
        heading-done: "Launching",
        heading-prepare: "Preparing to launch",
        subtitle-failed: "Try again or view the error details.",
        subtitle-done: "Your app will open shortly.",
        subtitle-prepare: "Your app opens when setup is complete.",
        status-failed: "Unable to complete setup",
        status-verifying: "Verifying and installing",
        status-done: "Runtime ready",
        status-checking: "Preparing the runtime",
        status-downloading: "Downloading the runtime",
        badge-retry: "Retry needed",
        badge-verifying: "Verifying",
        badge-wait: "Please wait",
        hint-failed: "Try again. Open error details if the problem persists.",
        hint-done: "Opening your app…",
        hint-verifying: "Download complete. Checking files and installing the runtime…",
        hint-checking: "Connecting and checking the runtime…",
        hint-downloading: "Downloading the runtime. Please stay connected.",
        accessible-verifying: "Verifying and installing the runtime",
        accessible-progress: "Runtime download progress",
        retry: "Retry",
        hide-details: "Hide details",
        error-details: "Error details",
        accessible-details: "Error details; select text to copy",
        step-download: "Download",
        step-verify: "Verify & install",
        step-launch: "Launch app",
        resume-hint: "Retry will attempt to resume the download.",
    };
}
