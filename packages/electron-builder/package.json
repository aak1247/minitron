{
  "name": "minitron-builder",
  "version": "0.4.1",
  "description": "Build smaller Electron installers with electron-builder and a shared runtime",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aak1247/minitron.git",
    "directory": "packages/electron-builder"
  },
  "main": "./index.js",
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron/asar": "3.4.1",
    "chromium-pickle-js": "^0.2.0",
    "electron-builder": "24.13.3",
    "yauzl": "3.4.0",
    "tar": "7.5.22",
    "app-builder-lib": "24.13.3",
    "builder-util": "24.13.1",
    "read-config-file": "6.3.2",
    "pngjs": "7.0.0"
  },
  "files": [
    "index.js",
    "lib/",
    "installer.nsh",
    "__minitron_bootstrap__.cjs",
    "__minitron_bootstrap__.mjs",
    "README.md",
    "bin/"
  ],
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "minitron-builder": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/aak1247/minitron#readme",
  "bugs": {
    "url": "https://github.com/aak1247/minitron/issues"
  },
  "keywords": [
    "electron",
    "electron-builder",
    "packaging",
    "shared-runtime",
    "installer"
  ]
}
